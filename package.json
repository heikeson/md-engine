{
  "name": "@heikeson/md-engine",
  "version": "0.1.0",
  "type": "module",
  "description": "Markdown 内容引擎：尖括号容器语法（<Callout> 等）解析、渲染、序列化与编辑器内核，可直接消费 TS 源码",
  "license": "MIT",
  "author": "heikeson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heikeson/md-engine.git"
  },
  "homepage": "https://github.com/heikeson/md-engine#readme",
  "bugs": {
    "url": "https://github.com/heikeson/md-engine/issues"
  },
  "keywords": [
    "markdown",
    "micromark",
    "mdast",
    "unified",
    "remark",
    "codemirror",
    "callout",
    "fumadocs"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "import": "./dist/editor/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./styles.css": "./styles/engine.css"
  },
  "files": [
    "dist",
    "styles",
    "README.md",
    "对接契约.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite --config dev/vite.config.ts",
    "build": "tsup",
    "snapshot": "vite build --config dev/snapshot.vite.config.ts && vite build --config dev/snapshot.css.vite.config.ts && node dev/.out/snapshot.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run typecheck"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@types/hast": "^3.0.5",
    "@types/mdast": "4.0.4",
    "clsx": "2.1.1",
    "hast-util-to-jsx-runtime": "2.3.6",
    "lucide-react": "^1.61.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-to-hast": "13.2.1",
    "mdast-util-to-markdown": "2.1.2",
    "micromark-extension-gfm": "3.0.0",
    "micromark-util-character": "2.1.1",
    "micromark-util-types": "2.0.2",
    "rehype-katex": "7.0.1",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "tailwind-merge": "3.6.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
