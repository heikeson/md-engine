# @file .gitignore
# @description Git 忽略清单：排除依赖、构建产物、IDE 数据与临时文件。
#   构建产物 dist/ 不入库——由 tsup 在发布前生成，保证提交树干净。
#   package-lock.json 入库，锁定依赖版本保证构建可复现。
# @created 2026-10-24 19:57
# @updated 2026-10-25 11:40

# —— 依赖 ——
node_modules/

# —— 构建产物（由 tsup 生成，不入库）——
dist/
*.tsbuildinfo

# —— npm pack 产物 ——
*.tgz

# —— 本地渲染产物（dev server 与静态快照的临时输出）——
dev/.out/

# —— 临时与日志 ——
*.log
.tmp/
.cache/

# —— IDE 与工具数据 ——
.vscode/
.idea/
.codebuddy/
*.code-workspace

# —— 系统文件 ——
.DS_Store
Thumbs.db
